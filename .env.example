# Copy to .env, replace every CHANGE_ME value, and never commit .env.
# Linux/WSL: set AIRFLOW_UID to the output of: id -u
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2
AIRFLOW_PROJ_DIR=.

# Generate a Fernet key and a separate random JWT secret; see README.md.
FERNET_KEY=CHANGE_ME_GENERATED_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_STRONG_LOCAL_UI_PASSWORD

# Local-development convenience only; startup installation is repeated.
# Production should build a pinned custom image instead.
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-snowflake==6.17.0 apache-airflow-providers-standard==1.19.0 apache-airflow-providers-celery==3.24.0 apache-airflow-providers-fab==3.9.0
