flowchart TB

    %% ===================================
    %% AIRFLOW CONTROLLER - IMPLEMENTED
    %% TaskGroups reuse real tasks, not child DAG triggers.
    %% ===================================
    ENTRY["Airflow UI: retail_full_etl → Trigger → Backfill<br/>Nov 9–13; Reprocess failed; Max active runs = 1; oldest first<br/>Airflow creates daily runs of the EXISTING pipeline"]
    subgraph ORCH["AIRFLOW 3.3.2 - ONE DAILY DAG RUN PER BUSINESS DATE"]
        direction LR
        START["retail_full_etl - 14 tasks<br/>Daily UTC data_interval_start supplies business date<br/>Run ID Nov 10 means business date Nov 9<br/>Native past/downstream dependency waits for prior reconciliation"] --> RSTG["run_stg<br/>Expandable TaskGroup"]
        RSTG --> RTMP["run_tmp<br/>Expandable TaskGroup"]
        RTMP --> RTGT["run_gold<br/>Expandable TaskGroup"]
    end
    ENTRY --> START

    %% ===================================
    %% SOURCE DATA - CURRENT TEST FIXTURE
    %% Counts are fixture details, not runtime constraints.
    %% ===================================
    subgraph SOURCES["SOURCE - LOCAL DATA DIRECTORY | CURRENT 17-CSV FIXTURE"]
        direction LR
        SI["ITEM MASTER<br/>5 daily CSV files"]
        SS["STORE MASTER<br/>2 applicable snapshots"]
        SP["POS SALES<br/>5 daily CSV files"]
        SN["INVENTORY<br/>5 daily CSV files"]
    end

    %% ===================================
    %% STG - BRONZE
    %% ===================================
    subgraph BRONZE["STG - BRONZE | run_stg | Reuses retail_stg_ingestion tasks"]
        direction TB
        DISC["discover_files<br/>Native scheduled/backfill: exact data_interval_start date<br/>Manual trigger: original bulk file_limit behavior<br/>Earlier replay: require identical loaded files and complete raw counts"]
        SELECTION["Daily selection contract<br/>Item, sales, inventory required every date<br/>Store file optional; reuse earlier accepted snapshot<br/>No controller, helper DAG, API connection, or bootstrap workflow"]
        SELECTION -.-> DISC
        MAP["ingest_one.expand<br/>One mapped task per physical file"]
        HASH["Calculate SHA-256 and SOURCE_FILE_ID<br/>Check manifest before loading<br/>Identical loaded file: SKIP<br/>Same filename with changed bytes: FAIL"]
        UPLOAD["Validate CSV structure; create JSONL with SOURCE_ROW_ID<br/>Snowflake CSV_LANDING<br/>PUT + COPY into load buffer; verify row identities"]
        PUBLISH["BEGIN: MERGE immutable STG rows and file manifest<br/>COMMIT or ROLLBACK<br/>Never overwrite existing raw rows or IDs"]
        MANIFEST[("CONTROL.FILE_MANIFEST<br/>Filename, hash, status, counts<br/>Original ingestion run lineage")]

        STGI[("STG.ITEM_MASTER<br/>RAW_PAYLOAD VARIANT")]
        STGS[("STG.STORE_MASTER<br/>RAW_PAYLOAD VARIANT")]
        STGP[("STG.POS_SALES<br/>RAW_PAYLOAD VARIANT")]
        STGN[("STG.INVENTORY_SNAPSHOT<br/>RAW_PAYLOAD VARIANT")]

        DISC --> MAP --> HASH -->|"New file"| UPLOAD --> PUBLISH
        PUBLISH --> MANIFEST
        PUBLISH --> STGI
        PUBLISH --> STGS
        PUBLISH --> STGP
        PUBLISH --> STGN
    end

    %% ===================================
    %% TMP - SILVER
    %% Each load_tmp task executes validation AND atomic publication.
    %% ===================================
    subgraph SILVER["TMP - SILVER | run_tmp | Current-day raw scope; prior master reference reads"]
        direction TB

        VI["load_tmp_item_master<br/>validate_item_master.sql<br/>Type and master validation + publication"]
        VS["load_tmp_store_master<br/>validate_store_master.sql<br/>Store and district validation + publication"]
        VP["load_tmp_pos_sales<br/>validate_pos_sales.sql<br/>Required keys, quantities,<br/>references and duplicates + publication"]
        VN["load_tmp_inventory_snapshot<br/>validate_inventory_snapshot.sql<br/>Quantity, cost and value checks + publication"]

        TI[("TMP.ITEM_MASTER")]
        TS[("TMP.STORE_MASTER")]
        TP[("TMP.POS_SALES")]
        TN[("TMP.INVENTORY_SNAPSHOT")]

        VI --> VS --> VP --> VN

        VI -->|"Accepted: conditional MERGE"| TI
        VS -->|"Accepted: conditional MERGE"| TS
        VP -->|"Accepted: conditional MERGE"| TP
        VN -->|"Accepted: conditional MERGE"| TN

        DQ[("DQ.QUARANTINE_RECORDS<br/>Source lineage, reason code,<br/>reason detail, raw payload<br/>Current disposition, not append-only history")]

        VI -->|"Rejected: conditional MERGE"| DQ
        VS -->|"Rejected: conditional MERGE"| DQ
        VP -->|"Rejected: conditional MERGE"| DQ
        VN -->|"Rejected: conditional MERGE"| DQ

        CONTRACT["IMPLEMENTED - Publication contract inside each Silver task<br/>Build session-local WORK table before BEGIN<br/>Check unique identities and exact STG/work coverage<br/>BEGIN: remove only accepted/rejected disposition flips<br/>MERGE TMP on SOURCE_ROW_ID<br/>MERGE DQ on SOURCE_TYPE + SOURCE_ROW_ID<br/>Null-safe changed-value checks; unchanged rows are no-ops<br/>Verify counts, classification and exclusivity before COMMIT<br/>ROLLBACK and raise on error; preserve unchanged timestamps"]
        CONTRACT -.->|"Applies to all four tasks"| VI
    end

    %% ===================================
    %% TGT - GOLD
    %% Arrows in this section retain actual sequential task order.
    %% ===================================
    subgraph GOLD["TGT - GOLD | run_gold | Daily writes; history reads and affected interval closures"]
        direction TB

        DC[("DIM_DATE<br/>Continuous shared calendar; configured full years")]
        D1[("DIM_SUBCLASS<br/>load_dim_subclass - SCD1 update in place")]
        D2[("DIM_DISTRICT<br/>load_dim_district - SCD1 update in place")]

        D3[("DIM_ITEM<br/>load_dim_item - SCD2 item history<br/>Surrogate key + effective dates")]
        D4[("DIM_LOCN<br/>load_dim_locn - SCD2 store history<br/>Surrogate key + effective dates")]

        FS[("FCT_SALES<br/>load_sales - MERGE accepted sales lines<br/>Historical ITEM_SK / LOCN_SK at sale date")]

        FI[("FCT_INVENTORY<br/>load_inventory - Validate daily observations<br/>Historical keys at snapshot date<br/>Change-compressed position history; preserve prior versions")]
        FD[("FCT_INVENTORY_DAILY<br/>One accepted store/item/date observation<br/>Published by load_inventory; no inferred missing balances")]

        REC["reconcile_gold<br/>Daily sales row and amount checks<br/>Historical keys, interval and uniqueness checks<br/>Inventory observation coverage checks<br/>Raise on mismatch; results logged, not persisted"]

        DC --> D1 --> D2 --> D3 --> D4
        D4 --> FS --> FI --> REC
        FI --> FD --> REC
    end

    %% ===================================
    %% EXECUTION AND DATA LINKS
    %% Dotted orchestration links mean containment/reuse, not triggers.
    %% ===================================
    RSTG -.->|"Contains real tasks"| DISC
    RTMP -.->|"Contains real tasks"| VI
    RTGT -.->|"Contains real tasks"| DC
    PUBLISH -->|"All mapped ingest tasks succeed before Silver"| VI
    VN -->|"Silver TaskGroup succeeds before Gold"| DC

    SI --> DISC
    SS --> DISC
    SP --> DISC
    SN --> DISC

    STGI --> VI
    STGS --> VS
    STGP --> VP
    STGN --> VN

    TI --> D1
    TI --> D3
    TS --> D2
    TS --> D4
    TP --> FS
    TN --> FI

    D3 -->|"Historical item key"| FS
    D4 -->|"Historical store key"| FS
    D3 -->|"Historical item key"| FI
    D4 -->|"Historical store key"| FI

    STGP -->|"Raw sales counts and amounts"| REC
    TP -->|"Accepted sales counts and amounts"| REC
    DQ -->|"Rejected sales and exclusion checks"| REC

    %% ===================================
    %% RECONCILIATION
    %% Decision and outcomes illustrate reconcile_gold behavior,
    %% not additional Airflow tasks or persisted batch status.
    %% ===================================
    subgraph ACCEPT["FINAL QUALITY GATE - reconcile_gold OUTCOME"]
        direction TB
        RULES{"All checks pass?<br/>Raw sales = Accepted sales + Rejected sales<br/>Gold sales = Accepted sales<br/>Valid history and inventory observation coverage"}
        OK(["Pipeline SUCCESS"])
        BAD(["Pipeline FAILED<br/>Investigate reconciliation"])
        RULES -->|"Yes"| OK
        RULES -->|"No: raise error"| BAD
    end
    REC --> RULES
    OK --> COMPLETE["Airflow records DAG SUCCESS<br/>Next day's discover_files can then proceed<br/>Failed days must be fixed before advancing"]

    %% ===================================
    %% OPERATING CONSTRAINTS
    %% ===================================
    SAFETY["Existing full DAG only; max_active_runs = 1<br/>Also set native Backfill Max active runs = 1; Run backwards OFF<br/>discover_files depends_on_past + wait_for_downstream includes final reconciliation<br/>Daily schedule; catchup=False; unpausing enables automatic daily runs<br/>Do not run standalone layers or external writers concurrently"]
    SAFETY -.-> ORCH
    CORR["retail_historical_correction<br/>Approved complete file replacement<br/>Hold one-slot retail_writer pool for whole task<br/>Archive superseded raw/manifest/DQ; replace active STG<br/>Revalidate all history and repair Gold in one DML transaction<br/>Commit only after reconciliation; rollback on failure"]
    CORR -.-> BRONZE
    CORR -.-> SILVER
    CORR -.-> GOLD

    %% ===================================
    %% STYLING
