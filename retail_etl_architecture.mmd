    classDef implemented fill:#E5F4EC,stroke:#287A53,color:#143E2B,stroke-width:1.5px;
    classDef source fill:#EAF1FA,stroke:#446B9B,color:#173653;
    classDef storage fill:#EEF1F5,stroke:#637487,color:#273747;
    classDef quarantine fill:#FCE8E8,stroke:#C04A4A,color:#742727;
    classDef constraint fill:#F2F2F2,stroke:#888888,color:#454545,stroke-dasharray:4 4;
    classDef success fill:#DDF4E5,stroke:#238354,color:#145C37;
    classDef failure fill:#FBE2E2,stroke:#BD4040,color:#7B2020;

    class ENTRY,START,RSTG,RTMP,RTGT,DISC,SELECTION,MAP,HASH,UPLOAD,PUBLISH,VI,VS,VP,VN,CONTRACT,REC,COMPLETE implemented;
    class SI,SS,SP,SN source;
    class STGI,STGS,STGP,STGN,MANIFEST,TI,TS,TP,TN,D1,D2,D3,D4,FS,FI storage;
    class DQ quarantine;
    class SAFETY constraint;
    class OK success;
    class BAD failure;
